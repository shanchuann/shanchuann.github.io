    <script>
        // --- Theme Toggle Logic ---
        const themeToggleBtn = document.getElementById('theme-toggle');
        const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle');
        const iconSun = document.getElementById('icon-sun');
        const iconMoon = document.getElementById('icon-moon');

        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            updateIcon(true);
        } else {
            document.documentElement.classList.remove('dark');
            updateIcon(false);
        }

        function toggleTheme(event) {
            const isDark = document.documentElement.classList.contains('dark');
            const toggleAction = () => {
                if (isDark) {
                    document.documentElement.classList.remove('dark');
                    localStorage.theme = 'light';
                    updateIcon(false);
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.theme = 'dark';
                    updateIcon(true);
                }
            };

            if (!document.startViewTransition) {
                toggleAction();
                return;
            }

            const x = event?.clientX ?? innerWidth / 2;
            const y = event?.clientY ?? innerHeight / 2;
            const endRadius = Math.hypot(
                Math.max(x, innerWidth - x),
                Math.max(y, innerHeight - y)
            );

            const transition = document.startViewTransition(() => {
                toggleAction();
            });

            transition.ready.then(() => {
                const clipPath = [
                    `circle(0px at ${x}px ${y}px)`,
                    `circle(${endRadius}px at ${x}px ${y}px)`
                ];
                
                document.documentElement.animate(
                    { clipPath: clipPath },
                    {
                        duration: 500,
                        easing: 'ease-in-out',
                        pseudoElement: '::view-transition-new(root)'
                    }
                );
            });
        }

        function updateIcon(isDark) {
            if (isDark) {
                iconSun.classList.remove('hidden');
                iconMoon.classList.add('hidden');
            } else {
                iconSun.classList.add('hidden');
                iconMoon.classList.remove('hidden');
            }
        }

        themeToggleBtn.addEventListener('click', toggleTheme);
        mobileThemeToggleBtn.addEventListener('click', toggleTheme);

        // --- Typewriter Effect ---
        const texts = ["C++ Developer", "System Architect", "Network Engineer"];
        let count = 0;
        let index = 0;
        let currentText = "";
        let letter = "";
        
        const typewriterEl = document.getElementById("typewriter");
        if (typewriterEl) {
            (function type() {
                if (count === texts.length) {
                    count = 0;
                }
                currentText = texts[count];
                letter = currentText.slice(0, ++index);
                
                typewriterEl.textContent = letter;
                
                if (letter.length === currentText.length) {
                    setTimeout(() => {
                        count++;
                        index = 0;
                        type();
                    }, 2000);
                } else {
                    setTimeout(type, 150); 
                }
            })();
        }

        // --- Intersection Observer ---
        const observerOptions = {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px"
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    if(entry.target.querySelector('.skill-progress')) {
                        const bars = entry.target.querySelectorAll('.skill-progress');
                        bars.forEach(bar => {
                            bar.style.width = bar.getAttribute('data-width');
                        });
                    }
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-up').forEach(el => {
            observer.observe(el);
        });

        // --- Tilt Effect ---
        document.querySelectorAll('.tilt-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((y - centerY) / centerY) * -5;
                const rotateY = ((x - centerX) / centerX) * 5;
                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';
            });
        });

        // --- Mouse Follower ---
        const cursorGlow = document.getElementById('cursor-glow');
        let mouseX = 0, mouseY = 0;
        let cursorX = 0, cursorY = 0;

        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        });

        function animateCursor() {
            const dx = mouseX - cursorX;
            const dy = mouseY - cursorY;
            cursorX += dx * 0.15;
            cursorY += dy * 0.15;
            cursorGlow.style.left = cursorX + 'px';
            cursorGlow.style.top = cursorY + 'px';
            requestAnimationFrame(animateCursor);
        }
        animateCursor();

        // --- Mobile Menu ---
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            const icon = menuBtn.querySelector('i');
            if(mobileMenu.classList.contains('hidden')){
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
            } else {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-times');
            }
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuBtn.querySelector('i').classList.remove('fa-times');
                menuBtn.querySelector('i').classList.add('fa-bars');
            });
        });
        
        // --- Form Handling ---
        const contactForm = document.getElementById('contact-form');
        contactForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = contactForm.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'TRANSMITTING... <i class="fa fa-spinner fa-spin ml-2"></i>';
            submitBtn.classList.add('opacity-70', 'cursor-not-allowed');

            try {
                const response = await fetch(contactForm.action, {
                    method: contactForm.method,
                    body: new FormData(contactForm),
                    headers: { 'Accept': 'application/json' }
                });

                if (response.ok) {
                    alert('Message Transmitted Successfully.');
                    contactForm.reset();
                } else {
                    alert("Transmission Failed.");
                }
            } catch (error) {
                alert("Network Error.");
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
                submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        });

        // --- Profile Image Interactive Effect ---
        const profileContainer = document.getElementById('profile-container');
        const profileImage = document.getElementById('profile-image');
        const profileShine = document.getElementById('profile-shine');

        if (profileContainer && profileImage && profileShine) {
            profileContainer.addEventListener('mousemove', (e) => {
                const rect = profileContainer.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                // Calculate rotation (limited to 15 degrees)
                const rotateX = ((y - centerY) / centerY) * -15;
                const rotateY = ((x - centerX) / centerX) * 15;

                // Apply transformation
                profileImage.style.transform = `
                    perspective(1000px) 
                    rotateX(${rotateX}deg) 
                    rotateY(${rotateY}deg) 
                    scale3d(1.05, 1.05, 1.05)
                `;

                // Move shine effect
                profileShine.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.2), transparent 60%)`;
                profileShine.style.opacity = '1';
            });

            profileContainer.addEventListener('mouseleave', () => {
                profileImage.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';
                profileShine.style.opacity = '0';
            });
        }
    </script>
    <script type="module">
        import { prepareWithSegments, layoutNextLine } from 'https://esm.sh/@chenglou/pretext';

        const canvas = document.getElementById('pretext-canvas');
        
        
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let width, height;

            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                const dpr = window.devicePixelRatio || 1;
                canvas.width = width * dpr;
                canvas.height = height * dpr;
                ctx.scale(dpr, dpr);
            }
            window.addEventListener('resize', resize);
            resize();

            // 超长文本，用于填满整个巨大的 Canvas
            const baseText = "Zhang Nianchuan. System Architect. C/C++ Engine. While others focus on the surface, I dive deep into the kernel. High-concurrency scaling, GPU Acceleration, TCP/IP, Libevent, MySQL, LangChain, Next.js, Redis, Docker, Distributed Systems. Software engineering is not just about writing code, it's about building resilient architectures that withstand the test of time and scale. Memory management, pointer arithmetic, multi-threading paradigms, lock-free data structures, and asynchronous I/O architectures are the building blocks of true performance. From low-level socket programming to high-level system design, every layer of the stack matters. Optimizing CPU cache lines, reducing page faults, and minimizing context switches distinguish a good application from an extraordinary one. The pursuit of zero-cost abstractions, RAII, and deterministic memory allocation in modern C++ empowers developers to construct high-throughput engines without sacrificing safety. Microservices orchestration, containerization with Kubernetes, real-time message brokers like Kafka, and protocol buffers ensure seamless communication across clusters. Whether it is a real-time reservation system or a machine learning inference pipeline, the principles of solid concurrency control, database indexing schemas, and load balancing remain the same. The digital future requires scalable foundations, robust error handling, and a meticulous approach to latency reduction. We architect the invisible infrastructure that powers the visible world. Mastery over the POSIX API, epoll, kqueue, and standard template library semantics provides the raw power necessary to handle millions of concurrent connections. Embracing modern DevSecOps, CI/CD pipelines, and rigorous unit testing frameworks guarantees that deployment is as reliable as the code itself. As the boundaries of cloud computing and edge processing blur, true architects must navigate the complexities of CAP theorem, consensus algorithms like Raft and Paxos, and eventual consistency models in scalable NoSQL datastores. Building reliable systems means preparing for network partitions, node failures, and Byzantine faults with resilient retry mechanisms and exponential backoff strategies. The art of software architecture is a continuous journey of balancing trade-offs between memory, CPU, bandwidth, and development velocity. Hello World. ";
            // 使用零宽空格 (\u200B) 分割每一个字符，从而强制 Pretext 以字母为单位进行排队打断
            const text = baseText.repeat(10).split('').join('\u200B'); 

            // 粗犷/强结构感的等宽字体
            const fontConfig = '16px "JetBrains Mono", monospace';
            
            // Pretext 核心：预处理执行一次，极速建立 AST 及字距缓存
            const prepared = prepareWithSegments(text, fontConfig);

            let mouseX = width / 2;
            let targetMouseX = width / 2;
            let mouseY = height / 2;
            let targetMouseY = height / 2;
            // 力场半径 = 光标可见边界（CSS 变量）+ 外发光延展 + 安全边距
            // 与 #cursor-glow 视觉范围对齐，确保文字被推到光晕之外，而不是穿过它
            const rootStyle = getComputedStyle(document.documentElement);
            const cursorRadiusPx = parseFloat(rootStyle.getPropertyValue('--cursor-radius')) || 150;
            const cursorGlowSpreadPx = parseFloat(rootStyle.getPropertyValue('--cursor-glow-spread')) || 25;
            const RADIUS = cursorRadiusPx + cursorGlowSpreadPx + 8; // ~183px：硬边框150 + 外发光25 + 8px缓冲
            const MARGIN = 80; // 两侧边框
            const LINE_HEIGHT = 26;

            let viewportMouseX = width / 2;
            let viewportMouseY = height / 2;

            window.addEventListener('mousemove', (e) => {
                viewportMouseX = e.clientX;
                viewportMouseY = e.clientY;
            });

            function render() {
                // Ensure canvas rect triggers absolute positioning mapping correctly on scroll
                const rect = canvas.getBoundingClientRect();
                targetMouseX = viewportMouseX - rect.left;
                targetMouseY = viewportMouseY - rect.top;

                ctx.clearRect(0, 0, width, height);

                // Lerp 平滑计算鼠标和光标镜头
                mouseX += (targetMouseX - mouseX) * 0.15;
                mouseY += (targetMouseY - mouseY) * 0.15;
                
                

                ctx.font = fontConfig;
                // 检测当前是否是 Dark 模式，并动态平滑切换文字颜色
                const isDark = document.documentElement.classList.contains('dark');
                ctx.fillStyle = isDark ? '#334155' : '#cbd5e1'; // 根据深浅模式设置不同的系统色系
                ctx.textBaseline = 'top';

                let cursor = { segmentIndex: 0, graphemeIndex: 0 };
                let y = MARGIN;

                // 圆形裁剪区：保证 RADIUS 内的字形像素在物理层面被擦除，
                // 兜底 layoutNextLine 偶发的字符级溢出（实测约 50-70px 的尾字超界）。
                ctx.save();
                ctx.beginPath();
                ctx.rect(0, 0, width, height);
                ctx.arc(mouseX, mouseY, RADIUS, 0, Math.PI * 2);
                ctx.clip('evenodd');

                // [核心颠覆]：极速环绕计算 (Collision Wrap Engine)
                // 每一帧都在计算并重排全屏所有的文字，躲避鼠标黑洞！
                while (true) {
                    // 判断当前行 y 是否在光标黑洞范围内
                    let dy = Math.abs(mouseY - (y + LINE_HEIGHT/2));
                    if (dy < RADIUS) {
                        // 使用勾股定理计算出当前行被黑洞遮挡的横向空洞大小
                        let dx = Math.sqrt(RADIUS * RADIUS - dy * dy);
                        let holeStart = mouseX - dx;
                        let holeEnd = mouseX + dx;

                        // 计算左半边可用宽度
                        let leftWidth = holeStart - MARGIN;
                        if (leftWidth > 30) {
                            const lineLeft = layoutNextLine(prepared, cursor, leftWidth);
                            if (lineLeft) {
                                ctx.fillText(lineLeft.text, MARGIN, y);
                                cursor = lineLeft.end;
                            }
                        }
                        
                        // 计算右半边可用宽度
                        let rightWidth = width - holeEnd - MARGIN;
                        if (rightWidth > 30) {
                            const lineRight = layoutNextLine(prepared, cursor, rightWidth);
                            if (lineRight) {
                                ctx.fillText(lineRight.text, holeEnd, y);
                                cursor = lineRight.end;
                            }
                        }

                    } else {
                        // 如果没有触碰到力场，正常横行铺满排版
                        const line = layoutNextLine(prepared, cursor, width - MARGIN * 2);
                        if (!line) break;
                        ctx.fillText(line.text, MARGIN, y);
                        cursor = line.end;
                    }
                    
                    y += LINE_HEIGHT;
                    if (y > height - MARGIN) break; // 超出屏幕下方即停止渲染
                }

                ctx.restore();

                requestAnimationFrame(render);
            }

            render();

            // --- Advanced Typewriter Effect for Hero ---
            const heroPhrases = [
                { top: 'SYSTEM', bottom: 'ARCHITECT' },
                { top: 'C/C++', bottom: 'ENGINEER' },
                { top: 'CORE', bottom: 'KERNEL' },
                { top: 'BACKEND', bottom: 'DEVELOPER' }
            ];
            let phraseIdx = 0;
            const title1 = document.getElementById('hero-title-1');
            const title2 = document.getElementById('hero-title-2');
            
            if (title1 && title2) {
                let isDeleting = true;
                let fullText = 'SYSTEM';
                let charIdx = fullText.length;
                
                function typeHero() {
                    const currentPhrase = heroPhrases[phraseIdx];
                    fullText = currentPhrase.top;

                    if (isDeleting) {
                        charIdx--;
                        title1.textContent = fullText.substring(0, charIdx);
                    } else {
                        charIdx++;
                        title1.textContent = fullText.substring(0, charIdx);
                    }

                    title2.textContent = currentPhrase.bottom;

                    let typeSpeed = isDeleting ? 40 : 120;

                    if (!isDeleting && charIdx === fullText.length) {
                        typeSpeed = 3000;
                        isDeleting = true;
                    } else if (isDeleting && charIdx === 0) {
                        isDeleting = false;
                        phraseIdx = (phraseIdx + 1) % heroPhrases.length;
                        typeSpeed = 400;
                    }
                    setTimeout(typeHero, typeSpeed);
                }
                
                setTimeout(typeHero, 2000);
            }
        }
    </script>

    <!-- Splash Screen Logic -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            let renderActive = true;
            let rafId;

            function raf(time) {
                if (renderActive && container && typeof renderer !== 'undefined') {
                    renderer.render(scene, camera);
                    rafId = requestAnimationFrame(raf);
                }
            }
            rafId = requestAnimationFrame(raf);

            // 2. Three.js Setup
            const container = document.getElementById('webgl-canvas-container');
            const scene = new THREE.Scene();
            const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
            camera.position.z = 1;

            const renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(1);
            renderer.setClearColor(0x000000, 0);
            container.appendChild(renderer.domElement);

            // 3. Shader Material
            const textureLoader = new THREE.TextureLoader();
            textureLoader.load('https://s2.loli.net/2025/09/25/bMEfVYwjH18cB5Q.png', (texture) => {
                const geometry = new THREE.PlaneGeometry(2, 2);

                const material = new THREE.ShaderMaterial({
                    uniforms: {
                        uTexture: { value: texture },
                        uProgress: { value: 0.0 }
                    },
                    vertexShader: `
                        varying vec2 vUv;
                        void main() {
                            vUv = uv;
                            gl_Position = vec4(position, 1.0);
                        }
                    `,
                    fragmentShader: `
                        uniform sampler2D uTexture;
                        uniform float uProgress;
                        varying vec2 vUv;

                        float random (vec2 st) {
                            return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
                        }

                        float noise (vec2 st) {
                            vec2 i = floor(st);
                            vec2 f = fract(st);

                            float a = random(i);
                            float b = random(i + vec2(1.0, 0.0));
                            float c = random(i + vec2(0.0, 1.0));
                            float d = random(i + vec2(1.0, 1.0));

                            vec2 u = f*f*(3.0-2.0*f);

                            return mix(a, b, u.x) +
                                    (c - a)* u.y * (1.0 - u.x) +
                                    (d - b) * u.x * u.y;
                        }

                        void main() {
                            vec4 color = texture2D(uTexture, vUv);
                            float dist = length(vUv - vec2(0.5));
                            float n = noise(vUv * 40.0);
                            float mask = dist + n * 0.8;
                            
                            if (mask < uProgress) discard;
                            gl_FragColor = color;
                        }
                    `,
                    transparent: true
                });

                const mesh = new THREE.Mesh(geometry, material);
                scene.add(mesh);

                // Ensure the canvas background turns transparent once the texture is rendered
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        container.style.backgroundImage = 'none';
                        container.style.backgroundColor = 'transparent';
                        
                        // Reveal the main content now that the splash screen is fully covering the viewport
                        const mainContent = document.getElementById("main-content");
                        if (mainContent) {
                            mainContent.style.opacity = '1';
                            mainContent.style.pointerEvents = 'auto';
                        }
                    });
                });

                // 4. Fake Loader
                let isLoaded = false;
                let loadingProgress = 0;
                let loadingInterval = setInterval(() => {
                    loadingProgress += Math.floor(Math.random() * 5) + 1; // Increment by 1-5
                    if (loadingProgress >= 100) {
                        loadingProgress = 100;
                        isLoaded = true;
                        clearInterval(loadingInterval);
                        
                        // Show prompt
                        const promptEl = document.getElementById('splash-prompt');
                        if (promptEl) promptEl.style.opacity = '1';
                    }
                    
                    // Update timer text
                    const timerEl = document.getElementById('splash-timer');
                    if (timerEl) {
                        timerEl.textContent = loadingProgress.toString().padStart(3, '0');
                    }
                }, 30);

                // 5. Virtual Scroll for Splash
                let virtualScroll = 0;
                let scrollMax = window.innerHeight * 1.5;
                let isComplete = false;
                
                let lastTouchY = 0;

                function handleScroll(e) {
                    if (!isLoaded || isComplete) return;
                    
                    let deltaY = 0;
                    if (e.type === 'wheel') {
                        deltaY = e.deltaY;
                    } else if (e.type === 'touchmove') {
                        let currentTouchY = e.touches[0].clientY;
                        if (lastTouchY !== 0) {
                            deltaY = lastTouchY - currentTouchY;
                        }
                        lastTouchY = currentTouchY;
                    }
                    
                    virtualScroll += deltaY;
                    if (virtualScroll < 0) virtualScroll = 0;
                    if (virtualScroll > scrollMax) virtualScroll = scrollMax;

                    let p = virtualScroll / scrollMax;

                    gsap.to(material.uniforms.uProgress, { value: p * 1.5, duration: 0.5, ease: "power2.out", overwrite: "auto" });
                    gsap.to("#emerging-text h1", { opacity: (p < 0.5 ? p * 2 : 1 - (p - 0.5) * 2), duration: 0.5, overwrite: "auto" });
                    gsap.to("#splash-ui", { opacity: 1 - p * 2, duration: 0.5, overwrite: "auto" });

                    if (p >= 1) {
                        isComplete = true;
                        
                        // Disable events completely
                        window.removeEventListener('wheel', handleScroll);
                        window.removeEventListener('touchmove', handleScroll);
                        window.removeEventListener('touchstart', handleTouchStart);
                        
                        // Cleanup
                        gsap.delayedCall(0.5, () => {
                            renderActive = false;
                            cancelAnimationFrame(rafId);
                            if (renderer) renderer.dispose();
                            if (geometry) geometry.dispose();
                            if (material) material.dispose();
                            if (texture) texture.dispose();
                            if (scene) scene.clear();
                            container.remove();

                            const text = document.getElementById("emerging-text");
                            if (text) text.remove();
                            
                            const splashUi = document.getElementById("splash-ui");
                            if (splashUi) splashUi.remove();

                            // Restore scrolling
                            document.body.classList.remove('overflow-hidden');
                        });
                    }
                }
                
                function handleTouchStart(e) {
                    lastTouchY = e.touches[0].clientY;
                }

                window.addEventListener('wheel', handleScroll, { passive: false });
                window.addEventListener('touchstart', handleTouchStart, { passive: false });
                window.addEventListener('touchmove', handleScroll, { passive: false });
            });

            window.addEventListener('resize', () => {
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.setPixelRatio(1);
            });
        });

        // --- Page Transition Animation ---
        document.addEventListener("DOMContentLoaded", () => {
            // Blinds container (flex row for vertical strip blinds spanning horizontally)
            const blindsContainer = document.createElement('div');
            blindsContainer.className = 'fixed inset-0 z-[9998] pointer-events-none flex flex-row';
            document.body.appendChild(blindsContainer);

            // Create 16 vertical blind elements for higher density
            const blindCount = 16;
            const blinds = [];
            for (let i = 0; i < blindCount; i++) {
                const blind = document.createElement('div');
                // Theme adaptation: light mode and dark mode, added relative positioning and strong shadow
                blind.className = 'flex-1 h-full bg-slate-50 dark:bg-[#0f172a] shadow-[10px_0_20px_-5px_rgba(0,0,0,0.3)] dark:shadow-[10px_0_20px_-5px_rgba(0,0,0,0.8)] relative';
                blind.style.zIndex = blindCount - i; // Ensued left blinds cast shadows over right ones
                blind.style.transform = 'scaleX(0)'; 
                blind.style.transformOrigin = 'left';
                blindsContainer.appendChild(blind);
                blinds.push(blind);
            }

            // Text container for transition title overlay 
            const textContainer = document.createElement('div');
            textContainer.className = 'fixed inset-0 z-[9999] pointer-events-none flex items-center justify-center';
            document.body.appendChild(textContainer);
            
            const overlayText = document.createElement('div');
            // Responsive text color and perspective container for 3D letter animation
            overlayText.className = 'text-slate-900 dark:text-white text-4xl md:text-6xl font-art font-extrabold tracking-widest flex items-center justify-center';
            overlayText.style.perspective = '1000px'; // Enable 3D space for children
            textContainer.appendChild(overlayText);

            // Select nav links that point to specific sections
            const navLinks = document.querySelectorAll('a[href^="#"]');
            
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    const targetId = this.getAttribute('href');
                    if (!['#projects', '#about', '#skills', '#contact'].includes(targetId)) return;
                    
                    const targetEl = document.querySelector(targetId);
                    if (!targetEl) return;

                    e.preventDefault();
                    
                    let linkText = this.textContent.trim().toUpperCase();
                    if (!linkText) linkText = targetId.substring(1).toUpperCase();
                    
                    // Split text into spans for per-letter 3D animation
                    overlayText.innerHTML = linkText.split('').map(char => {
                        const isSpace = char === ' ';
                        return `<span class="inline-block" style="min-width: ${isSpace ? '1.5rem' : 'auto'}">${char}</span>`;
                    }).join('');
                    
                    const chars = overlayText.querySelectorAll('span');
                    
                    // Reset states: blinds start from left, text is hidden and flipped backward
                    gsap.set(blinds, { scaleX: 0, transformOrigin: 'left' });
                    gsap.set(chars, { y: 40, opacity: 0, rotationX: -90, transformOrigin: '50% 50% -20px' });

                    const tl = gsap.timeline();
                    
                    // Blinds closing
                    tl.to(blinds, {
                        scaleX: 1,
                        duration: 0.35,
                        stagger: 0.025,
                        ease: 'power3.inOut'
                    })
                    // Characters animating in with a 3D flip and spring effect
                    .to(chars, {
                        y: 0,
                        opacity: 1,
                        rotationX: 0,
                        duration: 0.4,
                        stagger: 0.02,
                        ease: 'back.out(1.7)'
                    }, "-=0.2")
                    .call(() => {
                        // Switch section & clear smooth scrolling temporarily
                        document.documentElement.classList.remove('scroll-smooth');
                        window.scrollTo(0, targetEl.offsetTop);
                        
                        // Close mobile menu if open
                        const mobileMenu = document.getElementById('mobile-menu');
                        const mobileMenuBtn = document.getElementById('menu-btn');
                        if (mobileMenu && !mobileMenu.classList.contains('hidden') && mobileMenuBtn) {
                            mobileMenu.classList.add('hidden');
                            const icon = mobileMenuBtn.querySelector('i');
                            if (icon) {
                                icon.classList.remove('fa-times');
                                icon.classList.add('fa-bars');
                            }
                        }
                    })
                    // Characters animating out
                    .to(chars, {
                        y: -30,
                        opacity: 0,
                        rotationX: 90,
                        duration: 0.25,
                        stagger: 0.015,
                        ease: 'power2.in',
                        delay: 0.1 
                    })
                    .call(() => {
                        // Change origin point to right for the blinds
                        gsap.set(blinds, { transformOrigin: 'right', scaleX: 1 });
                        document.documentElement.classList.add('scroll-smooth');
                        history.pushState(null, null, targetId);
                    })
                    // Blinds opening
                    .to(blinds, {
                        scaleX: 0,
                        duration: 0.35,
                        stagger: 0.025,
                        ease: 'power3.inOut'
                    });
                });
            });
        });

    </script>

    <!-- Custom Right-Side Progress Tracker -->
    <div id="custom-scroll-tracker" class="fixed right-6 lg:right-12 top-24 bottom-12 w-20 z-[100] pointer-events-none hidden md:flex flex-col items-center justify-center font-mono opacity-0 transition-opacity duration-700">
        <!-- Vertical Track Line -->
        <div class="absolute right-6 top-0 bottom-0 w-[2px] bg-slate-200/50 dark:bg-slate-700/50 shadow-[0_0_10px_rgba(0,255,204,0.1)] rounded-full"></div>
        
        <!-- Active Percentage Indicator (Middle) -->
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-14 h-14 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-mint-500/50 rounded-full flex items-center justify-center text-sm font-black text-mint-600 dark:text-mint-400 shadow-[0_0_15px_rgba(0,255,204,0.3)] z-30 transition-transform duration-300">
            <span id="tracker-percent">0%</span>
        </div>

        <!-- Labels Container -->
        <div id="tracker-labels" class="absolute right-16 top-0 bottom-0 w-32 z-20 overflow-visible">
            <!-- JS generates items here -->
        </div>
    </div>

    <script>
        // --- Magnetic Buttons ---
        document.addEventListener('DOMContentLoaded', () => {
            const magneticBtns = document.querySelectorAll('.magnetic-btn');

            magneticBtns.forEach(btn => {
                btn.addEventListener('mousemove', (e) => {
                    const rect = btn.getBoundingClientRect();
                    const x = e.clientX - rect.left - rect.width / 2;
                    const y = e.clientY - rect.top - rect.height / 2;
                    
                    gsap.to(btn, {
                        x: x * 0.3,
                        y: y * 0.3,
                        duration: 0.3,
                        ease: 'power2.out'
                    });
                });

                btn.addEventListener('mouseleave', () => {
                    gsap.to(btn, {
                        x: 0,
                        y: 0,
                        duration: 0.7,
                        ease: 'elastic.out(1, 0.3)'
                    });
                });
            });
        });

        // --- Logic for Right-Side Progress Tracker ---
        document.addEventListener('DOMContentLoaded', () => {
            const sectionsList = [
                { id: 'hero', name: 'HERO' },
                { id: 'projects', name: 'WORK' },
                { id: 'about', name: 'ABOUT' },
                { id: 'skills', name: 'SKILLS' },
                { id: 'contact', name: 'CONTACT' }
            ];

            const trackerContainer = document.getElementById('custom-scroll-tracker');
            const trackerLabels = document.getElementById('tracker-labels');
            const percentText = document.getElementById('tracker-percent');

            if (!trackerContainer) return;

            // Generate label elements
            const labelEls = sectionsList.map((sec) => {
                const el = document.createElement('div');
                el.className = 'absolute right-0 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-300 ease-out origin-right whitespace-nowrap drop-shadow-md';
                el.innerText = sec.name;
                el.style.transform = `translateY(100vh) scale(0.8)`;
                el.style.opacity = '0';
                trackerLabels.appendChild(el);
                return el;
            });

            function updateScrollTracker() {
                const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
                if (maxScroll <= 0) return;

                const scrollY = window.scrollY;
                if (scrollY > 10) {
                    trackerContainer.classList.remove('opacity-0');
                    trackerContainer.classList.add('opacity-100');
                } else {
                    trackerContainer.classList.add('opacity-0');
                    trackerContainer.classList.remove('opacity-100');
                }

                const globalProgress = Math.max(0, Math.min(1, scrollY / maxScroll));
                percentText.innerText = Math.round(globalProgress * 100) + '%';

                const trackHeight = trackerLabels.clientHeight;
                const gap = 44; // Increased spacing for stacked labels to fit larger text
                const total = sectionsList.length;

                sectionsList.forEach((sec, i) => {
                    const secEl = document.getElementById(sec.id);
                    if (!secEl) return;

                    const activeZone = 0.15; // Within 15% of viewport matching
                    const rect = secEl.getBoundingClientRect();
                    
                    // Ratio of how far this section's top is scrolled globally
                    const absoluteTop = rect.top + scrollY;
                    let targetProgress = absoluteTop / Math.max(1, maxScroll);
                    targetProgress = Math.max(0, Math.min(1, targetProgress));

                    const diff = targetProgress - globalProgress; 
                    const el = labelEls[i];
                    
                    let yPos, scale, opacity;
                    const topLimit = i * gap;
                    const bottomLimit = trackHeight - (total - i) * gap;

                    // If we reached the end of the page, force all to top stack
                    if (globalProgress >= 0.98) {
                        yPos = topLimit;
                        scale = (i === total - 1) ? 0.9 : 0.8;
                        opacity = (i === total - 1) ? 1 : 0.5; // Increased default opacity
                        if (i === total - 1) {
                            el.className = 'absolute right-4 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-500 ease-out origin-right whitespace-nowrap text-mint-500 dark:text-mint-400 font-black drop-shadow-[0_0_8px_rgba(0,255,204,0.5)]';
                        } else {
                            el.className = 'absolute right-0 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-500 ease-out origin-right whitespace-nowrap text-slate-500 dark:text-slate-400';
                        }
                    } 
                    else if (diff > activeZone) {
                        yPos = bottomLimit; 
                        scale = 0.8;
                        opacity = 0.5; // Increased default opacity
                        el.className = 'absolute right-0 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-500 ease-out origin-right whitespace-nowrap text-slate-500 dark:text-slate-400';
                    } else if (diff < -activeZone) {
                        yPos = topLimit;
                        scale = 0.8; 
                        opacity = 0.5; // Increased default opacity
                        el.className = 'absolute right-0 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-500 ease-out origin-right whitespace-nowrap text-slate-500 dark:text-slate-400';
                    } else {
                        // Smoothly transition from bottom up to top
                        const t = (activeZone - diff) / (activeZone * 2); 
                        yPos = bottomLimit - t * (bottomLimit - topLimit);
                        
                        const peak = 1 - (Math.abs(diff) / activeZone); 
                        scale = 0.8 + (0.2 * peak);
                        opacity = 0.5 + (0.5 * peak);
                        
                        if (peak > 0.5) {
                            el.className = 'absolute right-4 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-100 ease-out origin-right whitespace-nowrap text-mint-500 dark:text-mint-400 font-black drop-shadow-[0_0_8px_rgba(0,255,204,0.5)]';
                        } else {
                            el.className = 'absolute right-0 p-1 text-sm md:text-base font-bold tracking-[0.2em] transform transition-all duration-100 ease-out origin-right whitespace-nowrap text-slate-500 dark:text-slate-400';
                        }
                    }

                    el.style.transform = `translateY(${yPos}px) scale(${scale})`;
                    el.style.opacity = opacity;
                });
            }

            window.addEventListener('scroll', updateScrollTracker, { passive: true });
            // Add slight delays because layout/fonts might shift element positions
            setTimeout(updateScrollTracker, 100);
            setTimeout(updateScrollTracker, 1000);
        });
    </script>
</body>
</html>