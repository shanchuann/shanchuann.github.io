<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zhang Nianchuan | Developer Portfolio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    
    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        mint: {
                            100: "#CCFFCC",
                            200: "#99FFCC",
                            300: "#66FFCC",
                            400: "#33FFCC",
                            500: "#00FFCC",
                            600: "#00CC99",
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;600;700&family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;500&display=swap');

        :root {
            --primary-gradient: linear-gradient(135deg, #66FFCC 0%, #00CC99 100%);
            
            /* Light Mode Vars */
            --bg-base: #f8fafc;
            --text-base: #0f172a;
            --card-bg: rgba(255, 255, 255, 0.8);
            --card-border: rgba(0, 0, 0, 0.05);
            --nav-bg: rgba(255, 255, 255, 0.8);
        }

        .dark {
            /* Dark Mode Vars */
            --bg-base: #0f172a;
            --text-base: #e2e8f0;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.1);
            --nav-bg: rgba(15, 23, 42, 0.8);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-base);
            overflow-x: hidden;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        h1, h2, h3, h4, .font-heading {
            font-family: 'Space Grotesk', sans-serif;
        }
        
        /* Artistic Logo Font */
        .font-art {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        html {
            scrollbar-gutter: stable;
        }

        /* --- View Transition for Theme Toggle --- */
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation: none;
            mix-blend-mode: normal;
        }
        ::view-transition-old(root) {
            z-index: 1;
        }
        ::view-transition-new(root) {
            z-index: 9999;
        }

        /* --- Custom Scrollbar (Hidden) --- */
        ::-webkit-scrollbar {
            display: none;
        }
        body {
            -ms-overflow-style: none; /* IE and Edge */
            scrollbar-width: none; /* Firefox */
        }

        /* --- Glassmorphism Utilities --- */
        .glass-panel {
            background: var(--card-bg);
            backdrop-filter: blur(24px) saturate(2);
            -webkit-backdrop-filter: blur(24px) saturate(2);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15), inset 0 0 0 1px rgba(255, 255, 255, 0.2);
            transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        /* Add frosty shine to cards */
        .glass-panel::before {
            content: '';
            position: absolute;
            top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
            transform: skewX(-25deg);
            z-index: 10; pointer-events: none;
            transition: 0.5s;
        }
        .glass-panel:hover::before {
            left: 200%;
            transition: 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .dark .glass-panel {
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
        }

        .nav-glass {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(12px) saturate(1.5);
            -webkit-backdrop-filter: blur(12px) saturate(1.5);
            border-bottom: 1px solid rgba(0, 255, 204, 0.2); /* subtle lime border */
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .dark .nav-glass {
            background: rgba(15, 23, 42, 0.3);
            border-bottom: 1px solid rgba(0, 255, 204, 0.15);
        }

        .gradient-text {
    background: linear-gradient(135deg, #00FFCC 0%, #008060 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
}

/* --- Animations --- */
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }

        .fade-up {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Typewriter Cursor */
        .typing-cursor::after {
            content: '|';
            animation: blink 1s step-start infinite;
            color: #00FFCC;
        }
        @keyframes blink {
            50% { opacity: 0; }
        }

        /* --- Interactive Card (Tilt) --- */
        .tilt-card {
            transform-style: preserve-3d;
            transform: perspective(1000px);
        }
        .tilt-content {
            transform: translateZ(20px);
        }

        /* --- Primary Button --- */
        .btn-primary {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            border: none;
        }
        
        /* Light Mode */
        .btn-primary {
            background-color: #00CC99;
            color: white;
            box-shadow: 0 10px 15px -3px rgba(0, 204, 153, 0.3);
        }
        .btn-primary:hover {
            background-color: #009966;
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 204, 153, 0.4);
        }

        /* Dark Mode */
        .dark .btn-primary {
            background: var(--primary-gradient);
            box-shadow: 0 0 20px rgba(0, 204, 153, 0.3);
        }
        .dark .btn-primary:hover {
            box-shadow: 0 0 30px rgba(0, 204, 153, 0.5);
        }

        /* --- Skill Bar --- */
        .skill-progress {
            width: 0;
            transition: width 1.5s cubic-bezier(0.2, 1, 0.3, 1);
            background: linear-gradient(135deg, #66FFCC 0%, #00CC99 100%);
        }

        /* --- Unified Global Cursor --- */
        :root {
            /* Source of truth for cursor size — read by pretext canvas to size its repulsion field */
            --cursor-radius: 150px;
            --cursor-glow-spread: 25px;
        }
                 #cursor-glow {
            position: fixed;
            width: calc(var(--cursor-radius) * 2);
            height: calc(var(--cursor-radius) * 2);
            border: 2px solid rgba(0, 255, 204, 0.4);
            background: radial-gradient(circle, rgba(0, 255, 204, 0) 30%, rgba(0, 255, 204, 0.05) 85%); /* Changed to radial gradient to avoid rendering tearing on iGPUs */
            border-radius: 50%;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 9999;
            /* Removed backdrop-filter to prevent severe rendering bugs (half text clipping) on laptop integrated GPUs */
            box-shadow:
                inset 0 0 20px rgba(0, 255, 204, 0.2),
                0 0 var(--cursor-glow-spread) rgba(0, 255, 204, 0.2);
            transition: transform 0.05s ease-out, width 0.3s ease, height 0.3s ease;
            will-change: transform;
        }

        .dark #cursor-glow {
            /* Dark mode keeps the same lens */
        }

        html:not(.dark) #cursor-glow {
            /* Light mode keeps the same lens */
        }

        /* --- Profile Image Interaction Styles --- */
        #profile-container {
            transform-style: preserve-3d;
            perspective: 1000px;
            cursor: pointer;
        }
        #profile-image {
            transition: transform 0.1s ease-out;
            will-change: transform;
        }
        #profile-shine {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.2), transparent 60%);
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 10;
            border-radius: 0.75rem; /* Match rounded-xl */
        }
    </style>
    <!-- Handle scroll restoration and initial hiding to prevent shifts -->
    <script>
        if (history.scrollRestoration) {
            history.scrollRestoration = 'manual';
        }
        window.scrollTo(0, 0);
    </script>
</head>
<body class="antialiased selection:bg-mint-600 selection:text-white overflow-hidden">

    <div id="main-content" style="opacity: 0; pointer-events: none; transition: opacity 1s ease;">

    <!-- Interactive Flowing Morandi Gradient Background -->
    <div id="ambient-fluid-bg">
        <!-- Add a subtle grid overlay for texture -->
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-50 z-0"></div>
        <div class="fluid-blob blob-1"></div>
        <div class="fluid-blob blob-2"></div>
        <div class="fluid-blob blob-3"></div>
        <div class="fluid-blob blob-4"></div>
        <!-- 专为鼠标交互添加的跟随色块 -->
        <div class="interactive-blob"></div>
    </div>
    
    <style>
        #ambient-fluid-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            z-index: -1;
            background: var(--bg-base); /* Fallback */
            transition: background-color 0.5s ease;
        }

        .fluid-blob {
            position: absolute;
            border-radius: 50%;
            /* 取消高斯模糊效果，避免毛玻璃感 */
            opacity: 0.95;
            animation: float-blob infinite alternate ease-in-out;
            will-change: transform, margin;
            transition: margin 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        /* Ambient Morandi Colors per Blob - Light Mode */
        .blob-1 {
            width: 80vw;
            height: 80vh;
            background: radial-gradient(circle, #eedbc5, transparent 70%);
            top: -10vh;
            left: -10vw;
            animation-duration: 15s;
        }

        .blob-2 {
            width: 70vw;
            height: 70vh;
            background: radial-gradient(circle, #b9d8d6, transparent 70%);
            bottom: -15vh;
            right: -10vw;
            animation-duration: 18s;
            animation-delay: -5s;
        }

        .blob-3 {
            width: 70vw;
            height: 75vh;
            background: radial-gradient(circle, #e4ccc1, transparent 70%);
            top: 20vh;
            left: 50vw;
            animation-duration: 22s;
            animation-delay: -10s;
        }

        .blob-4 {
            width: 75vw;
            height: 75vh;
            background: radial-gradient(circle, #c3d2d3, transparent 70%);
            top: 40vh;
            left: -5vw;
            animation-duration: 20s;
            animation-delay: -2s;
        }
        
        /* Interactive Mouse Blob */
        .interactive-blob {
            position: absolute;
            width: 80vmin;
            height: 80vmin;
            background: radial-gradient(circle, rgba(163, 196, 188, 1) 0%, transparent 60%);
            border-radius: 50%;
            opacity: 1;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 1; 
            mix-blend-mode: color-burn; /* 更有侵略性的颜色混合 */
        }

        /* Ambient Morandi Colors per Blob - Dark Mode Adaptation (类似日间模式配色) */
        .dark .blob-1 { background: radial-gradient(circle, #eedbc5, transparent 70%); opacity: 0.15; }
        .dark .blob-2 { background: radial-gradient(circle, #b9d8d6, transparent 70%); opacity: 0.15; mix-blend-mode: normal; }
        .dark .blob-3 { background: radial-gradient(circle, #e4ccc1, transparent 70%); opacity: 0.15; mix-blend-mode: normal; }
        .dark .blob-4 { background: radial-gradient(circle, #c3d2d3, transparent 70%); opacity: 0.15; }
        .dark .interactive-blob { 
            display: none;
        }

        @keyframes float-blob {
            0% { transform: scale(1) translateY(0) rotate(0deg); }
            33% { transform: scale(1.1) translateY(-5vh) rotate(5deg); }
            66% { transform: scale(0.9) translateY(5vh) rotate(-5deg); }
            100% { transform: scale(1.05) translateY(-2vh) rotate(2deg); }
        }
    </style>

    <script>
        // Interactive Flowing Background Logic with enhanced mouse tracking
        document.addEventListener('DOMContentLoaded', () => {
            const blobs = document.querySelectorAll('.fluid-blob');
            const iblob = document.querySelector('.interactive-blob');
            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;
            
            // Used for lerp smooth tracking
            let curX = mouseX;
            let curY = mouseY;

            window.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
                
                // Shift background blobs with strong parallax reaction
                const offsetX = (mouseX / window.innerWidth - 0.5) * 150; 
                const offsetY = (mouseY / window.innerHeight - 0.5) * 150;

                blobs.forEach((blob, index) => {
                    const factor = (index + 1) * -0.7; // negative for opposite movement
                    // Use margin for translation so we don't overwrite the CSS transform animation
                    blob.style.marginLeft = `${offsetX * factor}px`;
                    blob.style.marginTop = `${offsetY * factor}px`;
                });
            });
            
            // Animation loop for the mouse-following blob
            function animateBlob() {
                curX += (mouseX - curX) * 0.05; // 0.05 is the smoothing factor
                curY += (mouseY - curY) * 0.05;
                if (iblob) {
                    iblob.style.left = `${curX}px`;
                    iblob.style.top = `${curY}px`;
                }
                requestAnimationFrame(animateBlob);
            }
            animateBlob();
        });
    </script>

    <!-- Splash Screen WebGL Container -->
    <div id="webgl-canvas-container" class="fixed inset-0 z-[100] pointer-events-none" style="background-image: url('https://s2.loli.net/2025/09/25/bMEfVYwjH18cB5Q.png'); background-size: 100% 100%; background-position: center; background-repeat: no-repeat; transition: background-image 0.5s ease;"></div>
    <div id="emerging-text" class="fixed inset-0 flex items-center justify-center pointer-events-none z-[90]">
        <h1 class="text-white text-6xl md:text-8xl font-bold font-mono tracking-widest opacity-0">SYSTEM INITIALIZED</h1>
    </div>

    <!-- Splash Top UI -->
    <div id="splash-ui" class="fixed inset-0 z-[101] flex flex-col justify-end p-8 pointer-events-none">
        <div class="relative z-10 flex flex-col items-start">
            <div id="splash-timer" class="font-bold text-[6rem] md:text-[8rem] leading-none font-mono" style="-webkit-text-stroke: 2px white; -webkit-text-fill-color: transparent;">000</div>
            <div id="splash-prompt" class="mt-2 text-white/80 text-lg md:text-xl tracking-[0.2em] uppercase opacity-0 transition-opacity duration-1000 font-art flex items-center gap-3">
                Scroll Down <i class="fa fa-angle-down animate-bounce"></i>
            </div>
        </div>
    </div>

    <!-- Interactive Background Glow -->
    <div id="cursor-glow"></div>

    <!-- Navigation -->
    <nav class="fixed w-full top-0 z-50 nav-glass transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <a href="#" class="text-2xl md:text-3xl font-extrabold tracking-tight font-art text-slate-900 dark:text-white hover:text-mint-500 dark:hover:text-mint-400 transition-colors flex items-center h-full">
                    ZhangNianchuan
                </a>
                
                <div class="hidden md:flex items-center space-x-8 text-sm font-medium tracking-wide text-slate-600 dark:text-slate-300 h-full">
                    <a href="#projects" class="hover:text-mint-600 dark:hover:text-mint-400 transition-colors relative group h-full flex items-center">
                        Projects
                        <span class="absolute bottom-6 left-0 w-0 h-0.5 bg-mint-500 transition-all group-hover:w-full"></span>
                    </a>
                    <a href="#about" class="hover:text-mint-600 dark:hover:text-mint-400 transition-colors relative group h-full flex items-center">
                        About
                        <span class="absolute bottom-6 left-0 w-0 h-0.5 bg-mint-500 transition-all group-hover:w-full"></span>
                    </a>
                    <a href="#skills" class="hover:text-mint-600 dark:hover:text-mint-400 transition-colors relative group h-full flex items-center">
                        Skills
                        <span class="absolute bottom-6 left-0 w-0 h-0.5 bg-mint-500 transition-all group-hover:w-full"></span>
                    </a>
                    
                    <button id="theme-toggle" class="p-2 rounded-full bg-slate-100/50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 hover:text-mint-600 dark:hover:text-mint-400 focus:outline-none transition-colors border border-transparent hover:border-mint-500/30">
                        <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <svg id="icon-moon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                    </button>

                    <div class="flex items-center pl-2">
                        <a href="#contact" class="magnetic-btn px-6 py-2.5 rounded-full bg-gradient-to-r from-mint-400 to-[#008060] hover:from-mint-100 hover:to-mint-600 text-slate-900 border-0 font-bold transition-all duration-300 flex items-center shadow-lg shadow-mint-500/30">
                            Contact
                        </a>
                    </div>
                </div>

                <button id="menu-btn" class="md:hidden text-slate-900 dark:text-white focus:outline-none p-2">
                    <i class="fa fa-bars text-xl"></i>
                </button>
            </div>
        </div>
        
        <div id="mobile-menu" class="hidden md:hidden absolute w-full bg-white dark:bg-[#0f172a] border-b border-slate-200 dark:border-slate-800 shadow-2xl">
            <div class="flex flex-col px-4 py-6 space-y-4 text-base font-medium text-slate-600 dark:text-slate-300">
                <a href="#projects" class="mobile-link block hover:text-mint-500">Projects</a>
                <a href="#about" class="mobile-link block hover:text-mint-500">About</a>
                <a href="#skills" class="mobile-link block hover:text-mint-500">Skills</a>
                <a href="#contact" class="mobile-link block hover:text-mint-500">Contact</a>
                <button id="mobile-theme-toggle" class="text-left flex items-center gap-2 hover:text-mint-500">
                    <span>Toggle Theme</span>
                    <i class="fa fa-adjust"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section (Subversive Interactive Typography) -->
    <section id="hero" class="h-screen w-full relative overflow-hidden flex flex-col justify-center items-center bg-transparent transition-colors duration-300">
            <!-- Bottom fade for smooth transition to Projects section -->
        <div class="absolute bottom-0 left-0 w-full h-48 bg-gradient-to-t from-transparent to-transparent z-10 pointer-events-none transition-colors duration-300"></div>

        <!-- The pure typography layer running on Canvas + Pretext -->
        <canvas id="pretext-canvas" class="absolute inset-0 w-full h-full opacity-90 z-0"></canvas>
        
        

        <div class="relative z-20 text-center pointer-events-none w-full max-w-5xl mx-auto px-4">
            <div class="inline-block mb-4 px-5 py-2 rounded-full border border-mint-500/30 bg-mint-500/10 text-mint-600 dark:text-mint-300 text-sm font-medium fade-up tracking-wide pointer-events-auto backdrop-blur-md">
                Available for new projects
            </div>

            <h1 class="text-5xl sm:text-6xl md:text-8xl lg:text-9xl font-black tracking-tight md:tracking-tighter mb-8 font-heading text-slate-900 dark:text-white fade-up transition-colors duration-300">
                <span id="hero-title-1" class="border-r-4 border-mint-500 pr-2 animate-pulse">SYSTEM</span><br>
                <span id="hero-title-2" class="text-transparent bg-clip-text bg-gradient-to-r from-mint-400 to-[#008060]" style="-webkit-text-stroke: 2px currentColor; line-height: 1.1;">ARCHITECT</span>
            </h1>
            
            <div class="flex flex-col sm:flex-row gap-5 justify-center fade-up pointer-events-auto" style="transition-delay: 300ms;">
                <a href="#projects" class="magnetic-btn px-10 py-4 rounded-full text-lg font-bold tracking-wide shadow-lg bg-gradient-to-r from-mint-400 to-[#008060] hover:from-mint-100 hover:to-mint-600 text-slate-900 border-0 transition-all">
                    View Work
                </a>
                <a href="#contact" class="magnetic-btn px-10 py-4 rounded-full bg-white/60 dark:bg-black/40 backdrop-blur-md text-slate-900 dark:text-white font-medium border border-mint-500/30 hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-black transition-all flex items-center justify-center group shadow-sm">
                    Contact Me
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="ml-2 group-hover:translate-x-1 transition-transform" style="vertical-align:middle">
                        <line x1="2" y1="9" x2="16" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <polyline points="11,5 16,9 11,13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
<style>
    .preserve-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; }
    .projects-sticky-wrap { height: 250vh; padding: 0; position: relative; }
</style>
<section id="projects" class="projects-sticky-wrap">
    <div class="sticky top-0 h-screen w-full flex flex-col items-center justify-start pt-[12vh] md:pt-[16vh] overflow-hidden pointer-events-none">
        
        <div class="w-full max-w-7xl mx-auto px-4 z-50 mb-8 md:mb-12" id="projects-title" style="transform: translateY(20px); opacity: 0;">
