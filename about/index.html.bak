<script>
    document.addEventListener("DOMContentLoaded", () => {
        const projectSec = document.getElementById("projects");
        const projectTitle = document.getElementById("projects-title");
        const projectGrid = document.getElementById("projects-grid");
        const panels = document.querySelectorAll(".project-panel");

        function updateScroll() {
            const rect = projectSec.getBoundingClientRect();
            // Total track is reduced. Fast-paced configuration.
            const totalScroll = rect.height - window.innerHeight;
            const rawProgress = -rect.top / totalScroll;
            const progress = Math.max(0, Math.min(1, rawProgress));

            // 1. Scale down (0.0 - 0.15)
            let scaleAmount = 1.05;
            if (progress < 0.15) {
                scaleAmount = 1.05 - (0.05 * (progress / 0.15));
            } else {
                scaleAmount = 1;
            }
            projectGrid.style.transform = "scale(" + scaleAmount + ")";

            // 2. Title Fade (0.15 - 0.3)
            let opacityAmt = 0;
            if (progress > 0.15) {
                opacityAmt = Math.min((progress - 0.15) / 0.15, 1);
            }
            projectTitle.style.opacity = opacityAmt;
            projectTitle.style.transform = "translateY(" + (20 - 20 * opacityAmt) + "px)";

            // 3. Gap & Corners (0.3 - 0.45)
            let gapProgress = 0;
            if(progress > 0.3) {
                gapProgress = Math.min((progress - 0.3) / 0.15, 1);
            }
            projectGrid.style.gap = (gapProgress * 32) + "px";
            const currentRadius = gapProgress * 16; 

            // Deal with Gap subpixel overlap by injecting a calculated negative bleed when gap = 0
            panels.forEach((panel, i) => {
                const front = panel.querySelector(".front-face");
                if (front) {
                    front.style.borderRadius = currentRadius + "px";
                    
                    // The core fix: while gap is 0, stretch the boundaries by 1px
                    if (gapProgress === 0) {
                        if (i === 0) { front.style.right = "-1px"; front.style.left = "0px"; }
                        else if (i === 1) { front.style.left = "-1px"; front.style.right = "-1px"; }
                        else if (i === 2) { front.style.left = "-1px"; front.style.right = "0px"; }
                    } else {
                        front.style.right = "0px";
                        front.style.left = "0px";
                    }
                }

                // 4. Panel Flips (0.45 - 0.95)
                const startFlip = 0.45; // 所有卡片同时开始翻转
                const endFlip = 0.85;   // 延迟翻转完成时间，使得速率更慢
                
                let flipProgress = 0;
                if(progress > startFlip) {
                    flipProgress = Math.min((progress - startFlip) / (endFlip - startFlip), 1);
                }
                
                let rotateY = flipProgress * 180;
                panel.style.transform = "rotateY(" + rotateY + "deg)";

                if(rotateY > 90) {
                    front.style.visibility = "hidden";
                    front.style.pointerEvents = "none";
                } else {
                    front.style.visibility = "visible";
                    front.style.pointerEvents = "auto";
                }
            });
            
            requestAnimationFrame(updateScroll);
        }

        requestAnimationFrame(updateScroll);
    });
</script>

